# Environment variables example file
# Copy this file to .env and update with your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=15372
API_DEBUG=false

# GUI Configuration
GUI_TITLE=Publish Helper
GUI_VERSION=1.4.5

# PT-Gen API Configuration
PTGEN_API_URL=
PTGEN_API_KEY=

# Image Hosting Configuration
IMAGE_HOST_TYPE=freeimage
IMAGE_HOST_API_URL=
IMAGE_HOST_API_KEY=

# Media Info Configuration
MEDIAINFO_PATH=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Temp directories
TEMP_DIR=temp
MEDIA_DIR=media
STATIC_DIR=static

# LongPT publishing
LONGPT_COOKIE=

# qBittorrent WebUI
QBIT_URL=http://127.0.0.1:8086
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_SKIP_CHECKING=true

# Auto publishing
AUTO_MEDIA_ROOT=C:\download\iqy
AUTO_ARCHIVE_ROOT=C:\download\comp
AUTO_LIST=auto_feed.txt
AUTO_PUBLISH_INTERVAL_MINUTES=30
AUTO_PUBLISH_STABLE_MINUTES=30
AUTO_PUBLISH_STABLE_PROBE_SECONDS=5
AUTO_PUBLISH_MAX_PER_RUN=1
AUTO_PUBLISH_MIN_CONFIDENCE=85
AUTO_SOURCE=DSNP WEB-DL
AUTO_TEAM=LongWeb
AUTO_SUBMIT=false
AUTO_DOWNLOAD=false
AUTO_VT_SERVICE=DisneyPlus
AUTO_VT_DEFAULT_QUALITY=2160
AUTO_VT_VIDEO_CODEC=h265
AUTO_VT_SUBTITLE_LANGUAGES=zh-Hans,zh-HK,en
AUTO_VT_AUDIO_LANGUAGES=en,zh
AUTO_VT_PROBE_TEMPLATE=poetry run vt dl --list {service} {url}
AUTO_VT_WORKDIR=.
AUTO_PUBLISH_STATE_DB=temp/auto_publish_state.sqlite3
LONGPT_UPLOAD_HTML=html/LongPT __ 发布 - Powered by NexusPHP.html
